# Newsletter → Google Sheet (Apps Script web app URL)
# Deploy google-apps-script/newsletter.gs then paste the /exec URL here.
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Fellowship application → Google Sheet
# Deploy google-apps-script/fellowship.gs then paste the /exec URL here.
VITE_FELLOWSHIP_SCRIPT_URL=https://script.google.com/macros/s/YOUR_FELLOWSHIP_DEPLOYMENT_ID/exec

# Optional: shared fallback for other application forms (FullTime, CoFoundathon, Investor)
# VITE_APPLICATIONS_SCRIPT_URL=
